        "animClass": "drama-scroll",
        "duration": "{duration}"
      },
      {
        "do": "call",
        "method": "floatText",
        "args": [
          "{x}",
          "{y}",
          "{'⚡ ' + cleanName}",
          "{color: '#ffd54a', size: textSize}"
        ]
