{
  "_comment": "Drama effect registry (Steve 2026-10-07, Scaffold #4). Data-driven definitions for drama overlay effects. Each effect is a sequence of steps (spawn, particles, call) with JS expressions evaluated in scope. Visual output is IDENTICAL to the hand-written methods — the JSON contains the same expressions. Migrated incrementally: 12 effects in v1, proving the pattern before the remaining 50+.",
  "_schema": {
    "anchor": "'screen' | 'tile' — tile provides cx/cy from tileCenter(x,y)",
    "audio": "audio cue name or null (wired via Drama.audioFor)",
    "computed": "ordered map of name -> JS expression, evaluated in scope (can reference params and earlier computed)",
    "id": "effect name, matches the Drama method name",
    "params": "list of expected args (documentation)",
    "step.animClass": "CSS animation class (defined in drama.js injected CSS)",
    "step.count": "for particles: {expression} evaluating to integer",
    "step.do": "'spawn' | 'particles' | 'call'",
    "step.duration": "{expression} or number (ms)",
    "step.html/step.css": "templates with {expression} placeholders",
    "step.method/step.args": "for call: Drama method name and array of {expression} args",
    "step.stagger": "for particles: ms between spawns",
    "step.vary": "for particles: per-particle vars — array (cycled by i) or JS expression (evaluated with i in scope)",
    "step.when": "optional JS expression — skip step if falsy",
    "steps": "array of steps to execute in order"
  },
  "ambushWarning": {
    "anchor": "tile",
    "audio": null,
    "computed": {
      "integration": "integration || 0",
      "vignetteDuration": "900 + integration * 200"
    },
    "params": [
      "x",
      "y",
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-vignette",
        "css": "position:absolute;inset:0;background:radial-gradient(ellipse at center, transparent 40%, rgba(255,30,30,0.35) 100%);",
        "do": "spawn",
        "duration": "{vignetteDuration}",
        "html": ""
      },
      {
        "animClass": "drama-ambushmark",
        "css": "position:absolute;left:{cx}px;top:{cy - 20}px;transform:translate(-50%,-100%);",
        "do": "spawn",
        "duration": "1200",
        "html": "<div style=\"font-size:32px;text-shadow:0 2px 8px rgba(0,0,0,0.9);\">⚠️</div>"
      },
      {
        "animClass": "drama-float",
        "css": "position:absolute;left:{cx}px;top:{cy - 50}px;transform:translate(-50%,-50%);color:#ff5252;font-size:20px;font-weight:bold;text-shadow:0 2px 4px rgba(0,0,0,0.8);white-space:nowrap;",
        "do": "spawn",
        "duration": "800",
        "html": "AMBUSH",
        "when": "integration >= 2"
      }
    ]
  },
  "celebration": {
    "anchor": "screen",
    "audio": null,
    "computed": {
      "count": "3 + integration",
      "duration": "1800 + integration * 200",
      "integration": "integration || 0"
    },
    "params": [
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-celebrate",
        "count": "{count}",
        "css": "position:absolute;left:{left}%;top:35%;",
        "do": "particles",
        "duration": "{duration}",
        "html": "<div style=\"font-size:{size}px;color:{color};text-shadow:0 1px 4px rgba(0,0,0,0.7);\">{note}</div>",
        "stagger": 150,
        "vary": {
          "color": "i % 2 ? '#ffd54a' : '#9be8ff'",
          "left": "15 + ((i * 41) % 70)",
          "note": [
            "♪",
            "♫",
            "♪"
          ],
          "size": "18 + (i % 2) * 6"
        }
      }
    ]
  },
  "contestCheer": {
    "anchor": "screen",
    "audio": null,
    "computed": {
      "count": "3 + integration * 2",
      "fontSize": "16 + integration * 4",
      "integration": "integration || 0"
    },
    "params": [
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-cheer",
        "count": "{count}",
        "css": "position:absolute;left:{x}%;top:15%;",
        "do": "particles",
        "duration": "1200",
        "html": "<div style=\"font-size:{fontSize}px;color:#ffd54a;text-shadow:0 0 8px #ffd54a;\">✨</div>",
        "stagger": 80,
        "vary": {
          "x": "20 + Math.random() * 60"
        }
      }
    ]
  },
  "contestJudging": {
    "anchor": "screen",
    "audio": null,
    "computed": {
      "duration": "1500 + integration * 300",
      "integration": "integration || 0"
    },
    "params": [
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-judge-dim",
        "css": "position:absolute;inset:0;background:rgba(0,0,0,0.4);backdrop-filter:grayscale(0.7);",
        "do": "spawn",
        "duration": "{duration}",
        "html": ""
      },
      {
        "animClass": "drama-judge-text",
        "css": "position:absolute;left:50%;top:30%;transform:translate(-50%,-50%);",
        "do": "spawn",
        "duration": "{duration}",
        "html": "<div style=\"font-size:20px;font-weight:bold;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,1);letter-spacing:4px;\">JUDGING</div>"
      }
    ]
  },
  "dawnBreak": {
    "anchor": "screen",
    "audio": null,
    "computed": {
      "alpha": "0.06 + integration * 0.04",
      "duration": "1600 + integration * 300",
      "integration": "integration || 0"
    },
    "params": [
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-dawnwash",
        "css": "position:absolute;inset:0;background:linear-gradient(to bottom, rgba(255,205,130,{alpha}), rgba(255,240,200,{alpha * 0.5}) 60%, transparent);",
        "do": "spawn",
        "duration": "{duration}",
        "html": ""
      }
    ]
  },
  "duskFall": {
    "anchor": "screen",
    "audio": null,
    "computed": {
      "alpha": "0.08 + integration * 0.04",
      "duration": "1600 + integration * 300",
      "integration": "integration || 0"
    },
    "params": [
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-duskwash",
        "css": "position:absolute;inset:0;background:linear-gradient(to bottom, rgba(110,60,140,{alpha}), rgba(255,140,60,{alpha * 0.7}) 70%, transparent);",
        "do": "spawn",
        "duration": "{duration}",
        "html": ""
      }
    ]
  },
  "harvestGlow": {
    "anchor": "screen",
    "audio": null,
    "computed": {
      "count": "3 + integration * 2",
      "duration": "1400 + integration * 200",
      "integration": "integration || 0"
    },
    "params": [
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-goldmote",
        "count": "{count}",
        "css": "position:absolute;left:{left}%;top:{top}%;",
        "do": "particles",
        "duration": "{duration}",
        "html": "<div style=\"font-size:{size}px;color:{g};text-shadow:0 1px 4px rgba(0,0,0,0.7);\">✦</div>",
        "stagger": 120,
        "vary": {
          "g": [
            "#ffd54a",
            "#e8b83a",
            "#fff2b0"
          ],
          "left": "10 + ((i * 37) % 80)",
          "size": "12 + (i % 3) * 4",
          "top": "30 + ((i * 53) % 40)"
        }
      }
    ]
  },
  "lootSparkle": {
    "anchor": "tile",
    "audio": null,
    "computed": {
      "count": "5 + integration * 3",
      "integration": "integration || 0"
    },
    "params": [
      "x",
      "y",
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-sparkle",
        "count": "{count}",
        "css": "position:absolute;left:{sx}px;top:{sy}px;transform:translate(-50%,-50%);",
        "do": "particles",
        "duration": "900",
        "html": "<div style=\"width:{sz}px;height:{sz}px;background:#ffd54a;clip-path:polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);\"></div>",
        "stagger": 50,
        "vary": {
          "ang": "(i / count) * Math.PI * 2 + Math.random() * 0.5",
          "dist": "15 + Math.random() * (20 + integration * 10)",
          "sx": "cx + Math.cos(ang) * dist",
          "sy": "cy + Math.sin(ang) * dist",
          "sz": "8 + Math.random() * 8"
        }
      }
    ]
  },
  "mourning": {
    "anchor": "screen",
    "audio": null,
    "computed": {
      "alpha": "0.08 + integration * 0.05",
      "duration": "2000 + integration * 300",
      "integration": "integration || 0"
    },
    "params": [
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-mourn",
        "css": "position:absolute;inset:0;background:linear-gradient(to bottom, rgba(110,118,130,{alpha}), rgba(80,88,100,{alpha * 0.6}) 70%, transparent);",
        "do": "spawn",
        "duration": "{duration}",
        "html": ""
      }
    ]
  },
  "soulWisp": {
    "anchor": "tile",
    "audio": null,
    "computed": {},
    "params": [
      "x",
      "y"
    ],
    "steps": [
      {
        "animClass": "drama-wisp",
        "css": "position:absolute;left:{cx - 15}px;top:{cy - 20}px;",
        "do": "spawn",
        "duration": "1200",
        "html": "<svg width=\"30\" height=\"40\" viewBox=\"0 0 30 40\"><ellipse cx=\"15\" cy=\"20\" rx=\"10\" ry=\"15\" fill=\"rgba(180,220,255,0.7)\"/></svg>"
      }
    ]
  },
  "trailMark": {
    "anchor": "tile",
    "audio": null,
    "computed": {
      "arrow": "direction === 'n' ? '↑' : direction === 's' ? '↓' : direction === 'e' ? '→' : direction === 'w' ? '←' : '•'",
      "integration": "integration || 0",
      "opacity": "0.4 + integration * 0.15"
    },
    "params": [
      "x",
      "y",
      "direction",
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-trail",
        "css": "position:absolute;left:{cx}px;top:{cy}px;transform:translate(-50%,-50%);",
        "do": "spawn",
        "duration": "3000",
        "html": "<div style=\"font-size:20px;opacity:{opacity};text-shadow:0 1px 3px rgba(0,0,0,0.7);\">🐾{arrow}</div>"
      }
    ]
  },
  "wildRipple": {
    "anchor": "tile",
    "audio": null,
    "computed": {
      "integration": "integration || 0",
      "size": "50 + integration * 10"
    },
    "params": [
      "x",
      "y",
      "integration"
    ],
    "steps": [
      {
        "animClass": "drama-ripple",
        "css": "position:absolute;left:{cx - size / 2}px;top:{cy - size / 2}px;",
        "do": "spawn",
        "duration": "600",
        "html": "<svg width=\"{size}\" height=\"{size}\" viewBox=\"0 0 80 80\"><circle cx=\"40\" cy=\"40\" r=\"30\" fill=\"none\" stroke=\"#7cfc9a\" stroke-width=\"2\" opacity=\"0.5\"/></svg>"
      }
    ]
  },
  "dodgeMiss": {
    "anchor": "tile",
    "params": [
      "x",
      "y",
      "integration"
    ],
    "computed": {
      "integration": "integration || 0",
      "missSize": "16 + integration * 2"
    },
    "steps": [
      {
        "do": "call",
        "method": "floatText",
        "args": [
          "{cx}",
          "{cy - 20}",
          "{'MISS'}",
          "{color: '#b0c4de', size: missSize}"
        ]
      },
      {
        "do": "spawn",
        "html": "<div style=\"font-size:32px;opacity:0.5;filter:blur(1px);\">👤</div>",
        "css": "position:absolute;left:{cx + 12}px;top:{cy - 10}px;transform:translate(-50%,-50%);",
        "animClass": "drama-afterimage",
        "duration": 600
      }
    ],
    "audio": null,
    "_bug": "BUG REPRODUCED: floatText receives pixel coords (cx, cy-20) and re-applies tileCenter, placing MISS at 50%/50% instead of the tile. Fix separately."
  },
  "playerHurt": {
    "anchor": "screen",
    "params": [
      "dmg",
      "integration"
    ],
    "computed": {
      "integration": "integration || 0",
      "alpha": "Math.min(0.45, 0.15 + (dmg / 100) + integration * 0.05)",
      "duration": "500 + integration * 100",
      "shakeAmt": "5 + Math.min(8, Math.floor(dmg / 5)) + integration * 2"
    },
    "steps": [
      {
        "do": "spawn",
        "html": "",
        "css": "position:absolute;inset:0;background:radial-gradient(ellipse at center, transparent 40%, rgba(200,0,0,{alpha}) 100%);",
        "animClass": "drama-vignette-red",
        "duration": "{duration}"
      },
      {
        "do": "call",
        "method": "shake",
        "args": [
          "{shakeAmt}"
        ]
      }
    ],
    "audio": null
  },
  "contestBoo": {
    "anchor": "screen",
    "params": [
      "integration"
    ],
    "computed": {
      "integration": "integration || 0",
      "count": "2 + integration"
    },
    "steps": [
      {
        "do": "call",
        "method": "flash",
        "args": [
          "rgba(255,60,60,0.15)",
          "500"
        ]
      },
      {
        "do": "particles",
        "count": "{count}",
        "stagger": 150,
        "vary": {
          "side": [
            "5%",
            "90%"
          ]
        },
        "html": "<div style=\"font-size:24px;color:#ff5252;text-shadow:0 0 10px #ff5252;\">👎</div>",
        "css": "position:absolute;left:{side};top:{30 + i * 15}%;",
        "animClass": "drama-boo",
        "duration": 1000
      }
    ],
    "audio": null
  },
  "secretShimmer": {
    "anchor": "screen",
    "params": [
      "title",
      "subtitle",
      "integration"
    ],
    "computed": {
      "integration": "integration || 0",
      "shimmerColor": "integration >= 2 ? 'rgba(255,215,74,0.25)' : 'rgba(255,215,74,0.12)'",
      "flashDur": "600 + (integration * 200)",
      "cardTitle": "title || '✨ SECRET FOUND'",
      "cardSub": "subtitle || ''",
      "cardIcon": "integration >= 3 ? '🗝️' : '✨'"
    },
    "steps": [
      {
        "do": "call",
        "method": "flash",
        "args": [
          "{shimmerColor}",
          "{flashDur}"
        ]
      },
      {
        "do": "call",
        "method": "heroCard",
        "args": [
          "{cardTitle}",
          "{cardSub}",
          "{cardIcon}"
        ]
      }
    ],
    "audio": null
  },
  "exclaim": {
    "anchor": "tile",
    "params": [
      "x",
      "y",
      "icon",
      "opts"
    ],
    "computed": {
      "integration": "(opts && opts.integration) || 0",
      "color": "icon === '!' ? '#ff5252' : icon === '?' ? '#ffd54a' : '#4df3ff'",
      "duration": "(opts && opts.duration) || 1500",
      "htmlL3": "'<div style=\"text-align:center;font-size:30px;line-height:1.1;font-weight:bold;color:' + color + ';text-shadow:0 0 14px ' + color + ',0 2px 6px rgba(0,0,0,0.9);\">' + icon + '<div style=\"font-size:12px;\">👁️</div></div>'",
      "htmlL2": "'<div style=\"font-size:28px;font-weight:bold;color:' + color + ';text-shadow:0 0 12px ' + color + ',0 2px 6px rgba(0,0,0,0.9);\">' + icon + '</div>'",
      "htmlL1": "'<div style=\"font-size:28px;font-weight:bold;color:' + color + ';text-shadow:0 2px 6px rgba(0,0,0,0.9);\">' + icon + '</div>'"
    },
    "steps": [
      {
        "do": "spawn",
        "when": "integration >= 3",
        "html": "{htmlL3}",
        "css": "position:absolute;left:{cx}px;top:{cy - 30}px;transform:translate(-50%,-100%);",
        "animClass": "drama-exclaim",
        "duration": "{duration}"
      },
      {
        "do": "spawn",
        "when": "integration === 2",
        "html": "{htmlL2}",
        "css": "position:absolute;left:{cx}px;top:{cy - 30}px;transform:translate(-50%,-100%);",
        "animClass": "drama-exclaim",
        "duration": "{duration}"
      },
      {
        "do": "spawn",
        "when": "integration < 2",
        "html": "{htmlL1}",
        "css": "position:absolute;left:{cx}px;top:{cy - 30}px;transform:translate(-50%,-100%);",
        "animClass": "drama-exclaim",
        "duration": "{duration}"
      }
    ],
    "audio": null
  },
  "npcAlert": {
    "anchor": "tile",
    "params": [
      "x",
      "y",
      "kind",
      "opts"
    ],
    "computed": {
      "integration": "(opts && opts.integration) || 0",
      "kinds": "{talk: {icon: '!', color: '#ff5252'}, curious: {icon: '?', color: '#ffd54a'}, dialogue: {icon: '💬', color: '#4df3ff'}, warn: {icon: '⚠️', color: '#ff9d45'}, heart: {icon: '❤️', color: '#ff6b9d'}, break: {icon: '💔', color: '#9e9e9e'}}",
      "k": "kinds[kind] || kinds.talk",
      "icon": "k.icon",
      "color": "k.color",
      "size": "28 + integration * 4",
      "shadow": "integration >= 3 ? 'text-shadow:0 0 14px ' + color + ',0 2px 6px rgba(0,0,0,0.9);' : integration >= 2 ? 'text-shadow:0 0 10px ' + color + ',0 2px 6px rgba(0,0,0,0.9);' : 'text-shadow:0 2px 6px rgba(0,0,0,0.9);'",
      "eye": "integration >= 3 ? '<div style=\"font-size:12px;\">👁️</div>' : ''",
      "duration": "(opts && opts.duration) || ((kind === 'heart' || kind === 'break') ? 2000 : 1500)",
      "html": "'<div style=\"text-align:center;font-size:' + size + 'px;line-height:1.1;font-weight:bold;color:' + color + ';' + shadow + '\">' + icon + eye + '</div>'"
    },
    "steps": [
      {
        "do": "spawn",
        "html": "{html}",
        "css": "position:absolute;left:{cx}px;top:{cy - 30}px;transform:translate(-50%,-100%);",
        "animClass": "drama-exclaim",
        "duration": "{duration}"
      }
    ],
    "audio": null
  },
  "critHit": {
    "anchor": "tile",
    "params": [
      "x",
      "y",
      "dmg",
      "integration"
    ],
    "computed": {
      "integration": "integration || 0",
      "hitSize": "90 + integration * 25",
      "critSize": "24 + integration * 6",
      "dmgSize": "18 + integration * 4",
      "shakeAmt": "4 + integration * 2",
      "hitOpts": "({color: '#ffeb3b', size: hitSize, integration: 0})"
    },
    "steps": [
      {
        "do": "call",
        "method": "hit",
        "args": [
          "{x}",
          "{y}",
          "{hitOpts}"
        ]
      },
      {
        "do": "call",
        "method": "floatText",
        "args": [
          "{cx}",
          "{cy - 25}",
          "{'CRIT!'}",
          "{color: '#ffeb3b', size: critSize}"
        ]
      },
      {
        "do": "call",
        "method": "floatText",
        "args": [
          "{cx}",
          "{cy + 20}",
          "{String(dmg)}",
          "{color: '#ffffff', size: dmgSize}"
        ]
      },
      {
        "do": "call",
        "when": "integration >= 2",
        "method": "shake",
        "args": [
          "{shakeAmt}"
        ]
      },
      {
        "do": "call",
        "when": "integration >= 3",
        "method": "flash",
        "args": [
          "rgba(255,235,59,0.18)",
          "400"
        ]
      }
    ],
    "audio": null,
    "_bug": "BUG REPRODUCED: floatText receives pixel coords, places at 50%/50%."
  },
  "contestLoser": {
    "anchor": "screen",
    "params": [
      "name",
      "integration"
    ],
    "computed": {
      "integration": "integration || 0",
      "heartDur": "2000 + (integration * 200)",
      "nameSize": "16 + integration * 2"
    },
    "steps": [
      {
        "do": "spawn",
        "html": "",
        "css": "position:absolute;inset:0;background:rgba(0,0,20,0.35);",
        "animClass": "drama-loser-dim",
        "duration": 2000
      },
      {
        "do": "spawn",
        "html": "<div style=\"font-size:40px;filter:grayscale(0.3);\">💔</div>",
        "css": "position:absolute;left:50%;top:35%;transform:translate(-50%,-50%);",
        "animClass": "drama-loser-heart",
        "duration": "{heartDur}"
      },
      {
        "do": "call",
        "method": "floatText",
        "args": [
          "{'50%'}",
          "{'50%'}",
          "{name}",
          "{color: '#a0a0c0', size: nameSize}"
        ]
      }
    ],
    "audio": null,
    "_note": "floatText('50%','50%') -> tileCenter returns 50%/50% (NaN index). Name at screen center."
  }
}
