      "textSize": "15 + (integration * 2)",
      "cleanName": "(skillName || 'skill').replace(/_/g, ' ')",
      "svg": "'<svg width=\"' + w + '\" height=\"' + h + '\" viewBox=\"0 0 44 110\"><rect x=\"14\" y=\"0\" width=\"16\" height=\"110\" fill=\"url(#skillgrad)\" opacity=\"0.85\"/><defs><linearGradient id=\"skillgrad\" x1=\"0\" y1=\"1\" x2=\"0\" y2=\"0\"><stop offset=\"0%\" stop-color=\"#4df3ff\" stop-opacity=\"0.1\"/><stop offset=\"100%\" stop-color=\"#4df3ff\" stop-opacity=\"0.9\"/></linearGradient></defs></svg>'"
    },
