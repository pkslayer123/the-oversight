      "html": "'<div style=\"position:relative;width:' + size + 'px;height:' + size + 'px;\"><svg width=\"' + size + '\" height=\"' + size + '\" viewBox=\"0 0 64 64\"><g stroke=\"#ffd54a\" stroke-width=\"2.5\" opacity=\"0.9\"><line x1=\"32\" y1=\"2\" x2=\"32\" y2=\"10\"/><line x1=\"32\" y1=\"54\" x2=\"32\" y2=\"62\"/><line x1=\"2\" y1=\"32\" x2=\"10\" y2=\"32\"/><line x1=\"54\" y1=\"32\" x2=\"62\" y2=\"32\"/><line x1=\"11\" y1=\"11\" x2=\"16\" y2=\"16\"/><line x1=\"48\" y1=\"48\" x2=\"53\" y2=\"53\"/><line x1=\"53\" y1=\"11\" x2=\"48\" y2=\"16\"/><line x1=\"16\" y1=\"48\" x2=\"11\" y2=\"53\"/></g></svg><div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:' + emojiSize + 'px;\">💡</div></div>'"
    },
    "steps": [
      {
        "do": "spawn",
